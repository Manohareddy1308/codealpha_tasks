# ShopEase Backend Environment Configuration Template
# Copy this file to .env and configure your local settings.
# Do not commit real secrets or production credentials to version control.

# Server port (default: 5000)
PORT=5000

# Allowed frontend origins for CORS (comma-separated URLs)
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Database connection settings
DB_HOST=localhost
# Default MySQL port is 3306; alternate installations may use 3307 or 3308
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shopease

# Session secret (required in production; generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=replace_this_with_a_long_random_secret

# Runtime environment (development | production)
NODE_ENV=development
